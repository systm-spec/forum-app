# Copy to .env.local. Compose, Next.js and Drizzle use the same values.
PGHOST=127.0.0.1
PGPORT=15432
PGDATABASE=forum
PGUSER=forum
PGPASSWORD=replace_with_a_random_database_password

# Generate independently, e.g. openssl rand -hex 32
AUTH_SECRET=replace_with_a_random_auth_secret
AUTH_URL=http://localhost:3000

# Existing account UUID; leave empty to disable Admin access.
ADMIN_USER_ID=
